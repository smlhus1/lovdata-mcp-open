{
  "name": "lovdata-mcp",
  "version": "0.1.0",
  "description": "MCP server for verbatim lookup and full-text search in current Norwegian laws and central regulations, built directly on Lovdata's open data (NLOD 2.0).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "lovdata-mcp": "src/server.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "update": "node src/update-cli.mjs",
    "pins": "node src/pins-cli.mjs",
    "radar": "node src/radar-cli.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "htmlparser2": "^12.0.0",
    "zod": "^4.6.7"
  }
}
